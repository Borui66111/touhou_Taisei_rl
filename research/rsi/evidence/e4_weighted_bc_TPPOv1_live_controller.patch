diff --git a/src/live_ppo_infer.h b/src/live_ppo_infer.h
new file mode 100644
--- /dev/null
+++ b/src/live_ppo_infer.h
@@ -0,0 +1,46 @@
+#pragma once
+#include <stdint.h>
+#include <string.h>
+#include <math.h>
+
+#define LIVE_PPO_NI 528
+#define LIVE_PPO_NW 128
+#define LIVE_PPO_NA 18
+#define LIVE_PPO_HEADER 52
+
+static inline uint32_t live_ppo_u32(const uint8_t *p) {
+    return p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static inline float live_ppo_f32(const uint8_t *p) {
+    uint32_t u = live_ppo_u32(p);
+    float f;
+    memcpy(&f, &u, sizeof(f));
+    return f;
+}
+
+static inline void live_ppo_infer_logits(const uint8_t *data, const float x[LIVE_PPO_NI], float out[LIVE_PPO_NA]) {
+    const uint8_t *p = data + LIVE_PPO_HEADER;
+    const uint8_t *w1 = p; p += LIVE_PPO_NW * LIVE_PPO_NI * 4;
+    const uint8_t *b1 = p; p += LIVE_PPO_NW * 4;
+    const uint8_t *w2 = p; p += LIVE_PPO_NW * LIVE_PPO_NW * 4;
+    const uint8_t *b2 = p; p += LIVE_PPO_NW * 4;
+    const uint8_t *wa = p; p += LIVE_PPO_NA * LIVE_PPO_NW * 4;
+    const uint8_t *ba = p;
+    float h1[LIVE_PPO_NW], h2[LIVE_PPO_NW];
+    for(int i = 0; i < LIVE_PPO_NW; ++i) {
+        double s = live_ppo_f32(b1 + 4 * i);
+        for(int j = 0; j < LIVE_PPO_NI; ++j) s += (double)live_ppo_f32(w1 + 4 * (i * LIVE_PPO_NI + j)) * x[j];
+        h1[i] = tanhf((float)s);
+    }
+    for(int i = 0; i < LIVE_PPO_NW; ++i) {
+        double s = live_ppo_f32(b2 + 4 * i);
+        for(int j = 0; j < LIVE_PPO_NW; ++j) s += (double)live_ppo_f32(w2 + 4 * (i * LIVE_PPO_NW + j)) * h1[j];
+        h2[i] = tanhf((float)s);
+    }
+    for(int i = 0; i < LIVE_PPO_NA; ++i) {
+        double s = live_ppo_f32(ba + 4 * i);
+        for(int j = 0; j < LIVE_PPO_NW; ++j) s += (double)live_ppo_f32(wa + 4 * (i * LIVE_PPO_NW + j)) * h2[j];
+        out[i] = (float)s;
+    }
+}
