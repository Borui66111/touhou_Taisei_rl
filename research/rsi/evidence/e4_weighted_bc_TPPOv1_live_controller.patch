diff --git a/src/live_ppo.c b/src/live_ppo.c
new file mode 100644
--- /dev/null
+++ b/src/live_ppo.c
@@ -0,0 +1,63 @@
+#include "live_ppo.h"
+#include "boss.h"
+#include "global.h"
+#include "log.h"
+#include "player.h"
+#include "projectile.h"
+#include "lasers/laser.h"
+#include "util/sha256.h"
+#include "live_ppo_infer.h"
+#include <stdio.h>
+#include <stdlib.h>
+#define NI LIVE_PPO_NI
+#define NW LIVE_PPO_NW
+#define NA LIVE_PPO_NA
+#define HEADER LIVE_PPO_HEADER
+#define NF (NW*NI+NW+NW*NW+NW+NA*NW+NA)
+#define FILESIZE (HEADER+NF*4)
+static char *path;
+static uint8_t *data;
+static char identity[65];
+static unsigned long n_actions;
+static bool load(void) {
+ if(data) return true; if(!path) return false;
+ FILE *f=fopen(path,"rb"); if(!f) { log_error("RL policy open failed; keeping native human input"); return false; }
+ if(fseek(f,0,SEEK_END)||ftell(f)!=FILESIZE||fseek(f,0,SEEK_SET)) { fclose(f); log_error("RL policy payload size invalid; keeping human input"); return false; }
+ uint8_t *b=malloc(FILESIZE); if(!b||fread(b,1,FILESIZE,f)!=FILESIZE||fgetc(f)!=EOF) { free(b); fclose(f); log_error("RL policy read failed; keeping human input"); return false; } fclose(f);
+ const uint8_t magic[8]="TPPOv1"; if(memcmp(b,magic,8)||live_ppo_u32(b+8)!=528||live_ppo_u32(b+12)!=128||live_ppo_u32(b+16)!=18) { free(b); log_error("RL policy header invalid; keeping human input"); return false; }
+ uint8_t digest[SHA256_BLOCK_SIZE]; sha256_digest(b,FILESIZE,digest,sizeof(digest));
+ static const uint8_t expected[32]={0xaf,0x96,0xb9,0xf2,0xe1,0xfe,0xf7,0x6f,0x9b,0xc6,0xa0,0xa6,0x17,0xcf,0x29,0x68,0x41,0xfb,0xf3,0x86,0x18,0x70,0xd9,0xb8,0xa6,0xd4,0xb0,0x2a,0x05,0xef,0x3b,0x13};
+ if(memcmp(digest,expected,sizeof(expected))) { free(b); log_error("RL policy binary SHA256 mismatch; keeping human input"); return false; }
+ const char hex[]="0123456789abcdef"; for(int i=0;i<32;i++) { identity[2*i]=hex[b[20+i]>>4]; identity[2*i+1]=hex[b[20+i]&15]; } identity[64]=0;
+ static_assert(SHA256_BLOCK_SIZE == 32);
+ if(strcmp(identity,"06c344d1c9415d1277e89c7d7c1a4519f274952f159e1cc5095d7fecf696e6fc")) { free(b); log_error("RL checkpoint SHA256 identity mismatch; keeping human input"); return false; }
+ data=b; log_info("RL policy loaded checkpoint_sha256=%s",identity); return true;
+}
+static int infer(const float x[NI]) {
+ float logits[NA]; live_ppo_infer_logits(data,x,logits);
+ int best=0; for(int i=1;i<NA;i++) if(logits[i]>logits[best]) best=i; return best;
+}
+typedef struct { double approach, distance; Projectile *p; size_t order; } Threat;
+static int cmpthreat(const void *a,const void *b) { const Threat*x=a,*y=b; if(x->approach!=y->approach)return x->approach<y->approach?-1:1; if(x->distance!=y->distance)return x->distance<y->distance?-1:1; return x->order<y->order?-1:x->order>y->order; }
+typedef struct PPO_LaserSample { double d; float x,y,w; size_t order; } PPO_LaserSample;
+static PPO_LaserSample lps[512]; static int nlps;
+static void *collect(Laser *l,const LaserTraceSample*s,void*a) { (void)a; if(!l->collision_active||!s->segment||nlps>=512)return NULL; PPO_LaserSample*q=&lps[nlps]; q->x=creal(s->pos)-creal(global.plr.pos); q->y=cimag(s->pos)-cimag(global.plr.pos); q->d=hypot(q->x,q->y); q->w=(s->segment->width.a+(s->segment->width.b-s->segment->width.a)*s->segment_param)*0.5f; q->order=(size_t)nlps++; return NULL; }
+static int cmplp(const void*a,const void*b) { const PPO_LaserSample*x=a,*y=b; if(x->d!=y->d)return x->d<y->d?-1:1; return x->order<y->order?-1:x->order>y->order; }
+static void observe(float*x) {
+ memset(x,0,NI*sizeof(*x)); Player*p=&global.plr; int k=0;
+ x[k++]=creal(p->pos)/480; x[k++]=cimag(p->pos)/560; x[k++]=creal(p->velocity)/20; x[k++]=cimag(p->velocity)/20; x[k++]=(p->inputflags&INFLAG_FOCUS)!=0; x[k++]=p->lives; x[k++]=p->bombs; x[k++]=player_is_vulnerable(p)?0:1;
+ Boss*b=global.boss; Attack*a=b?b->current:NULL; x[k++]=b!=NULL; x[k++]=b?(creal(b->pos)-creal(p->pos))/480:0; x[k++]=b?(cimag(b->pos)-cimag(p->pos))/560:0; x[k++]=a&&a->maxhp>0?a->hp/a->maxhp:0; x[k++]=a?(float)(a->type==AT_Normal?1:a->type==AT_Move?2:a->type==AT_Spellcard?3:a->type==AT_SurvivalSpell?4:a->type==AT_ExtraSpell?5:0):0; x[k++]=a&&a->timeout>0?fmaxf(0,a->starttime+a->timeout-global.frames)/3600:0;
+ Threat th[4096]; int nt=0; size_t order=0; for(Projectile*q=global.projs.first;q&&nt<4096;q=q->next,++order) if(q->type==PROJ_ENEMY) { double dx=creal(q->pos-p->pos),dy=cimag(q->pos-p->pos),vx=creal(q->move.velocity-p->velocity),vy=cimag(q->move.velocity-p->velocity),v2=vx*vx+vy*vy,t=v2>1e-9?fmin(30,fmax(0,-(dx*vx+dy*vy)/v2)):0; th[nt++]=(Threat){hypot(dx+vx*t,dy+vy*t),hypot(dx,dy),q,order}; }
+ qsort(th,nt,sizeof(*th),cmpthreat); for(int i=0;i<64;i++) { if(i<nt) { Projectile*q=th[i].p; x[k++]=(creal(q->pos)-creal(p->pos))/480; x[k++]=(cimag(q->pos)-cimag(p->pos))/560; x[k++]=creal(q->move.velocity)/20; x[k++]=cimag(q->move.velocity)/20; x[k++]=creal(q->collision_size)/30; x[k++]=cimag(q->collision_size)/30; x[k++]=1; } else k+=7; }
+ nlps=0; for(Laser*l=global.lasers.first;l;l=l->next)if(l->collision_active)laser_trace(l,8,collect,NULL); qsort(lps,nlps,sizeof(*lps),cmplp); for(int i=0;i<16;i++) { if(i<nlps) { x[k++]=lps[i].x/480; x[k++]=lps[i].y/560; x[k++]=lps[i].w/30; x[k++]=1; } else k+=4; }
+ int np=0,nl=0; for(Projectile*q=global.projs.first;q;q=q->next)if(q->type!=PROJ_PARTICLE)np++; for(Laser*l=global.lasers.first;l;l=l->next)nl++; x[k++]=np/1000.0f; x[k++]=nl/50.0f;
+}
+void live_ppo_set_policy_path(const char*p) { free(path); path=p?strdup(p):NULL; }
+void live_ppo_start(uint64_t seed,uint16_t stage_id,int difficulty,const char*mode,bool practice) { n_actions=0; if(path) log_info("RL run seed=%llu stage=%u difficulty=%d mode=%s practice=%d config_source=native",(unsigned long long)seed,stage_id,difficulty,mode?mode:"unknown",practice); }
+bool live_ppo_apply_action(void) {
+ if(!path||!load())return false; float x[NI]; observe(x); int a=infer(x); uint32_t d=INFLAG_SHOT; switch(a%9) { case 0:break;case 1:d|=INFLAG_UP;break;case 2:d|=INFLAG_DOWN;break;case 3:d|=INFLAG_LEFT;break;case 4:d|=INFLAG_RIGHT;break;case 5:d|=INFLAG_UP|INFLAG_LEFT;break;case 6:d|=INFLAG_UP|INFLAG_RIGHT;break;case 7:d|=INFLAG_DOWN|INFLAG_LEFT;break;case 8:d|=INFLAG_DOWN|INFLAG_RIGHT;break; } if(a>=9)d|=INFLAG_FOCUS;
+ const struct{uint32_t bit;KeyIndex key;} keys[]={{INFLAG_UP,KEY_UP},{INFLAG_DOWN,KEY_DOWN},{INFLAG_LEFT,KEY_LEFT},{INFLAG_RIGHT,KEY_RIGHT},{INFLAG_FOCUS,KEY_FOCUS},{INFLAG_SHOT,KEY_SHOT}};
+ for(size_t i=0;i<ARRAY_SIZE(keys);i++) { bool was=(global.plr.inputflags&keys[i].bit)!=0,want=(d&keys[i].bit)!=0; if(was!=want)player_event(&global.plr,NULL,&global.replay.output,want?EV_PRESS:EV_RELEASE,keys[i].key); }
+ ++n_actions; log_info("RL decision frame=%d action=%d action_count=%lu checkpoint_sha256=%s",global.frames,a,n_actions,identity); return true;
+}
+void live_ppo_finish(const char*outcome) { if(n_actions)log_info("RL policy outcome=%s frames=%d actions=%lu checkpoint_sha256=%s",outcome,global.frames,n_actions,identity); }
