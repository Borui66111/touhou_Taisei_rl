+/*
+ * This software is licensed under the terms of the MIT License.
+ * See COPYING for further information.
+ * ---
+ * libtaisei_sim — headless, externally stepped Taisei simulation.
+ *
+ * Reconstruction of the taisei-sim ABI v1 consumed by touhou_Taisei_rl
+ * (my_test/native_rl/taisei_ffi.py). Struct layouts mirror that binding field-for-field;
+ * every taisei_sim_sizeof_*() is checked by the binding before any gameplay call.
+ *
+ * All gameplay dynamics come from the unmodified upstream game logic; this library only
+ * drives the stage loop one logic frame at a time and reads entity state back.
+ *
+ * Restrictions: one simulation per process; not thread-safe; call everything from the
+ * thread that called taisei_sim_global_init().
+ */
+
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef TAISEI_SIM_BUILDING
+	#define TAISEI_SIM_API __attribute__((visibility("default")))
+#else
+	#define TAISEI_SIM_API
+#endif
+
+#define TAISEI_SIM_API_VERSION 1
+
+#define TAISEI_SIM_DEFAULT_I32 (-2147483647)
+#define TAISEI_SIM_DEFAULT_U64 UINT64_C(0xFFFFFFFFFFFFFFFF)
+
+enum {
+	TAISEI_SIM_BUTTON_UP      = 1,
+	TAISEI_SIM_BUTTON_DOWN    = 2,
+	TAISEI_SIM_BUTTON_LEFT    = 4,
+	TAISEI_SIM_BUTTON_RIGHT   = 8,
+	TAISEI_SIM_BUTTON_FOCUS   = 16,
+	TAISEI_SIM_BUTTON_SHOT    = 32,
+	TAISEI_SIM_BUTTON_BOMB    = 64,
+	TAISEI_SIM_BUTTON_SPECIAL = 128,
+};
+
+typedef enum TaiseiSimStatus {
+	TAISEI_SIM_STATUS_NONE    = 0,
+	TAISEI_SIM_STATUS_RUNNING = 1,
+	TAISEI_SIM_STATUS_WON     = 2,
+	TAISEI_SIM_STATUS_LOST    = 3,
+	TAISEI_SIM_STATUS_ABORTED = 4,
+	TAISEI_SIM_STATUS_ERROR   = 5,
+} TaiseiSimStatus;
+
+typedef enum TaiseiSimResult {
+	TAISEI_SIM_OK                   = 0,
+	TAISEI_SIM_E_INVALID_ARGUMENT   = -1,
+	TAISEI_SIM_E_BAD_STRUCT_SIZE    = -2,
+	TAISEI_SIM_E_API_VERSION        = -3,
+	TAISEI_SIM_E_NOT_INITIALIZED    = -4,
+	TAISEI_SIM_E_ALREADY_INITIALIZED= -5,
+	TAISEI_SIM_E_BUSY               = -6,  // a simulation already exists in this process
+	TAISEI_SIM_E_NO_EPISODE         = -7,
+	TAISEI_SIM_E_EPISODE_OVER       = -8,
+	TAISEI_SIM_E_UNKNOWN_STAGE      = -9,
+	TAISEI_SIM_E_IO                 = -10,
+	TAISEI_SIM_E_BUFFER_TOO_SMALL   = -11, // counts are still filled in
+	TAISEI_SIM_E_INTERNAL           = -12,
+} TaiseiSimResult;
+
+// Projectile categories (== upstream ProjType)
+enum {
+	TAISEI_SIM_PROJECTILE_ENEMY  = 1,
+	TAISEI_SIM_PROJECTILE_DEAD   = 2,
+	TAISEI_SIM_PROJECTILE_PLAYER = 4,
+};
+
+typedef struct TaiseiSimVec2 { double x, y; } TaiseiSimVec2;
+
+typedef struct TaiseiSimGlobalConfig {
+	uint32_t struct_size;
+	uint32_t api_version;
+	const char *resource_path;   // NULL: $TAISEI_RES_PATH or the platform default
+	const char *storage_path;    // NULL: fresh private temporary directory (deterministic defaults)
+	const char *cache_path;      // NULL: <storage>/cache
+	uint32_t flags;
+	uint32_t reserved;
+} TaiseiSimGlobalConfig;
+
+typedef struct TaiseiSimConfig {
+	uint32_t struct_size;
+	uint32_t flags;
+	double laser_sample_step;    // <= 0: export the quantized collision segments as-is
+	uint32_t reserved;
+} TaiseiSimConfig;
+
+typedef struct TaiseiSimEpisodeConfig {
+	uint32_t struct_size;
+	uint16_t stage_id;
+	uint8_t difficulty;          // 1=Easy 2=Normal 3=Hard 4=Lunatic (0: stage default)
+	uint8_t player_character;    // 0=Reimu 1=Marisa 2=Youmu
+	uint8_t shot_mode;           // 0=A 1=B
+	uint8_t practice_mode;
+	uint16_t reserved0;
+	uint64_t rng_seed;
+	uint64_t start_time;         // DEFAULT_U64: 0
+	int32_t initial_lives;       // DEFAULT_I32: keep game default
+	int32_t initial_bombs;
+	int32_t initial_life_fragments;
+	int32_t initial_bomb_fragments;
+	int32_t initial_power;
+	int32_t initial_point_item_value;
+	uint64_t initial_score;      // 0 or DEFAULT_U64: keep
+	uint32_t initial_graze;      // 0: keep
+	uint32_t reserved1;
+} TaiseiSimEpisodeConfig;
+
+typedef struct TaiseiSimAction {
+	uint32_t struct_size;
+	uint32_t buttons;
+} TaiseiSimAction;
+
+typedef struct TaiseiSimPlayerState {
+	TaiseiSimVec2 position, previous_position, velocity;
+	uint32_t input_flags, focused, shooting;
+	int32_t lives, bombs, life_fragments, bomb_fragments, stored_power, effective_power;
+	uint32_t point_item_value;
+	uint64_t score;
+	uint32_t graze, voltage;
+	uint32_t invulnerable, recovering, alive;
+	int32_t death_timer, respawn_timer, recovery_timer;
+	uint32_t bomb_active;
+	double bomb_progress;
+	int32_t bomb_trigger_frame, bomb_end_frame;
+	uint32_t power_surge_active;
+	float power_surge_positive, power_surge_negative;
+	uint8_t player_character, shot_mode;
+	uint16_t reserved;
+} TaiseiSimPlayerState;
+
+typedef struct TaiseiSimBossState {
+	uint32_t active;
+	TaiseiSimVec2 position, velocity;
+	float hp, max_hp;
+	uint32_t invulnerable;
+	int32_t phase_index;
+	uint32_t phase_type;          // AttackType + 1 (0: no current attack)
+	uint16_t attack_id, spell_id;
+	uint32_t spell_active;
+	int32_t phase_start_frame, phase_end_frame, phase_timeout_frames, remaining_timeout_frames;
+	int32_t spell_failed_frame;
+	uint32_t spell_failed, spell_captured;
+	float recent_damage;
+} TaiseiSimBossState;
+
+typedef struct TaiseiSimProjectileState {
+	uint32_t spawn_id, category;
+	TaiseiSimVec2 position, previous_position, velocity, collision_size;
+	float damage, angle;
+	int32_t age_frames;
+	uint32_t flags, damage_type, clear_flags;
+} TaiseiSimProjectileState;
+
+typedef struct TaiseiSimEnemyState {
+	uint32_t spawn_id;
+	TaiseiSimVec2 position, velocity;
+	float hp, max_hp, hit_radius, hurt_radius;
+	int32_t age_frames;
+	uint32_t flags, damageable, harmful;
+} TaiseiSimEnemyState;
+
+typedef struct TaiseiSimItemState {
+	uint32_t spawn_id;
+	TaiseiSimVec2 position, velocity;
+	uint32_t item_type;
+	int32_t age_frames, collect_frame;
+	uint32_t attracted;
+	float pickup_value;
+} TaiseiSimItemState;
+
+typedef struct TaiseiSimLaserState {
+	uint32_t spawn_id;
+	TaiseiSimVec2 origin;
+	int32_t age_frames;
+	float width, speed, timespan, death_time, time_shift;
+	uint32_t collision_active, unclearable, clear_flags;
+	uint32_t first_point, point_count;
+} TaiseiSimLaserState;
+
+enum {
+	TAISEI_SIM_LASER_POINT_SEGMENT_START = 1,
+	TAISEI_SIM_LASER_POINT_SEGMENT_END   = 2,
+	TAISEI_SIM_LASER_POINT_DISCONTINUITY = 4,
+};
+
+typedef struct TaiseiSimLaserPoint {
+	TaiseiSimVec2 position;
+	float half_width;            // visual half width (collision radius is max(half_width - 4, 2))
+	float time;
+	uint32_t flags;
+} TaiseiSimLaserPoint;
+
+typedef struct TaiseiSimState {
+	uint32_t struct_size, api_version;
+	uint16_t stage_id, stage_type;
+	uint8_t difficulty, player_character, shot_mode, practice_mode;
+	uint64_t logical_frame, initial_rng_seed, start_time;
+	uint32_t episode_status, stage_clear, game_over, reserved0;
+	uint64_t score;
+	uint32_t graze, voltage, deaths, bombs_used, continues_used;
+	int32_t gameover_frame, reserved2;
+	TaiseiSimPlayerState player;
+	TaiseiSimBossState boss;
+	uint32_t projectile_count, enemy_count, item_count, laser_count, laser_point_count, reserved1;
+	uint64_t gameplay_digest;
+} TaiseiSimState;
+
+typedef struct TaiseiSimStateBuffers {
+	uint32_t struct_size, reserved;
+	TaiseiSimProjectileState *projectiles; uint32_t projectile_capacity;
+	TaiseiSimEnemyState *enemies;          uint32_t enemy_capacity;
+	TaiseiSimItemState *items;             uint32_t item_capacity;
+	TaiseiSimLaserState *lasers;           uint32_t laser_capacity;
+	TaiseiSimLaserPoint *laser_points;     uint32_t laser_point_capacity;
+} TaiseiSimStateBuffers;
+
+typedef struct TaiseiSim TaiseiSim;
+
+TAISEI_SIM_API uint32_t taisei_sim_api_version(void);
+
+TAISEI_SIM_API size_t taisei_sim_sizeof_vec2(void);
+TAISEI_SIM_API size_t taisei_sim_sizeof_global_config(void);
+TAISEI_SIM_API size_t taisei_sim_sizeof_config(void);
+TAISEI_SIM_API size_t taisei_sim_sizeof_episode_config(void);
+TAISEI_SIM_API size_t taisei_sim_sizeof_action(void);
+TAISEI_SIM_API size_t taisei_sim_sizeof_state(void);
+TAISEI_SIM_API size_t taisei_sim_sizeof_state_buffers(void);
+TAISEI_SIM_API size_t taisei_sim_sizeof_player_state(void);
+TAISEI_SIM_API size_t taisei_sim_sizeof_boss_state(void);
+TAISEI_SIM_API size_t taisei_sim_sizeof_projectile_state(void);
+TAISEI_SIM_API size_t taisei_sim_sizeof_enemy_state(void);
+TAISEI_SIM_API size_t taisei_sim_sizeof_item_state(void);
+TAISEI_SIM_API size_t taisei_sim_sizeof_laser_state(void);
+TAISEI_SIM_API size_t taisei_sim_sizeof_laser_point(void);
+
+TAISEI_SIM_API int32_t taisei_sim_global_init(const TaiseiSimGlobalConfig *config);
+TAISEI_SIM_API int32_t taisei_sim_global_shutdown(void);
+
+TAISEI_SIM_API int32_t taisei_sim_create(const TaiseiSimConfig *config, TaiseiSim **out_sim);
+TAISEI_SIM_API int32_t taisei_sim_destroy(TaiseiSim *sim);
+
+TAISEI_SIM_API int32_t taisei_sim_reset(TaiseiSim *sim, const TaiseiSimEpisodeConfig *episode);
+TAISEI_SIM_API int32_t taisei_sim_step(TaiseiSim *sim, const TaiseiSimAction *action, uint32_t frames);
+TAISEI_SIM_API int32_t taisei_sim_get_state(TaiseiSim *sim, TaiseiSimState *state, TaiseiSimStateBuffers *buffers);
+TAISEI_SIM_API int32_t taisei_sim_save_replay(TaiseiSim *sim, const char *path);
+
+TAISEI_SIM_API const char *taisei_sim_last_error(TaiseiSim *sim);
