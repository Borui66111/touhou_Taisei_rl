@@ -0,0 +1,1213 @@
+/*
+ * This software is licensed under the terms of the MIT License.
+ * See COPYING for further information.
+ * ---
+ * libtaisei_sim — headless, externally stepped Taisei (taisei-sim ABI v1 reconstruction).
+ *
+ * Design:
+ *   - Initialization replicates main.c's headless (--verify-replay) path: null renderer,
+ *     null audio, dummy SDL video, no menus.
+ *   - An episode is a single stage entered exactly like `taisei --stage` (main_singlestg),
+ *     with the RNG seed supplied by the caller instead of makeseed().
+ *   - Input comes from a virtual keyboard (sim_hooks.h): press/release edges go through the
+ *     game's own gameplay input handler and gamekeypressed() reports the virtual key state,
+ *     so dialogs, the score screen, auto-surge, shot inversion etc. behave as with a real
+ *     keyboard. Every input is recorded into the output replay by the game itself.
+ *   - taisei_sim_step() runs N logic frames of the stage event loop; rendering never runs
+ *     (same as replay verification).
+ *   - Game over does not open the game-over menu; the episode ends with STATUS_LOST.
+ */
+
+#include "taisei.h"
+
+#include "taisei_sim.h"
+
+#include "audio/audio.h"
+#include "boss.h"
+#include "config.h"
+#include "coroutine/coroutine.h"
+#include "dialog.h"
+#include "dynstage.h"
+#include "enemy.h"
+#include "eventloop/eventloop.h"
+#include "eventloop/eventloop_private.h"
+#include "events.h"
+#include "filewatch/filewatch.h"
+#include "gamepad.h"
+#include "global.h"
+#include "i18n/i18n.h"
+#include "item.h"
+#include "lasers/internal.h"
+#include "lasers/laser.h"
+#include "log.h"
+#include "player.h"
+#include "plrmodes.h"
+#include "progress.h"
+#include "projectile.h"
+#include "renderer/api.h"
+#include "renderer/common/models.h"
+#include "renderer/common/sprite_batch.h"
+#include "replay/replay.h"
+#include "replay/stage.h"
+#include "replay/state.h"
+#include "replay/struct.h"
+#include "resource/resource.h"
+#include "rwops/rwops_stdiofp.h"
+#include "sim_hooks.h"
+#include "stage.h"
+#include "stageinfo.h"
+#include "stageobjects.h"
+#include "taskmanager.h"
+#include "thread.h"
+#include "util/env.h"
+#include "vfs/setup.h"
+#include "video.h"
+
+#include <locale.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+/* ---------------------------------------------------------------------------------------- */
+/* ABI self-checks                                                                          */
+/* ---------------------------------------------------------------------------------------- */
+
+#define SIZEOF_FN(name, type) TAISEI_SIM_API size_t taisei_sim_sizeof_##name(void) { return sizeof(type); }
+SIZEOF_FN(vec2, TaiseiSimVec2)
+SIZEOF_FN(global_config, TaiseiSimGlobalConfig)
+SIZEOF_FN(config, TaiseiSimConfig)
+SIZEOF_FN(episode_config, TaiseiSimEpisodeConfig)
+SIZEOF_FN(action, TaiseiSimAction)
+SIZEOF_FN(state, TaiseiSimState)
+SIZEOF_FN(state_buffers, TaiseiSimStateBuffers)
+SIZEOF_FN(player_state, TaiseiSimPlayerState)
+SIZEOF_FN(boss_state, TaiseiSimBossState)
+SIZEOF_FN(projectile_state, TaiseiSimProjectileState)
+SIZEOF_FN(enemy_state, TaiseiSimEnemyState)
+SIZEOF_FN(item_state, TaiseiSimItemState)
+SIZEOF_FN(laser_state, TaiseiSimLaserState)
+SIZEOF_FN(laser_point, TaiseiSimLaserPoint)
+
+static_assert(sizeof(TaiseiSimVec2) == 16, "Vec2 ABI");
+static_assert(sizeof(TaiseiSimAction) == 8, "Action ABI");
+
+TAISEI_SIM_API uint32_t taisei_sim_api_version(void) {
+	return TAISEI_SIM_API_VERSION;
+}
+
+/* ---------------------------------------------------------------------------------------- */
+/* State                                                                                    */
+/* ---------------------------------------------------------------------------------------- */
+
+#define SIM_ERRBUF_SIZE 512
+
+// After the game-over trigger, the original taisei-sim kept the episode RUNNING for 14 more
+// steps with the game frozen (the game-over menu pauses the stage) and reported LOST on the
+// 15th. Calibrated against the archived E3 native teacher trajectory (seed 48030, step 7841).
+#define SIM_GAMEOVER_FREEZE_FRAMES 15
+
+typedef struct SimArrays {
+	TaiseiSimProjectileState *projectiles; uint32_t num_projectiles, cap_projectiles;
+	TaiseiSimEnemyState *enemies;          uint32_t num_enemies, cap_enemies;
+	TaiseiSimItemState *items;             uint32_t num_items, cap_items;
+	TaiseiSimLaserState *lasers;           uint32_t num_lasers, cap_lasers;
+	TaiseiSimLaserPoint *laser_points;     uint32_t num_laser_points, cap_laser_points;
+} SimArrays;
+
+struct TaiseiSim {
+	TaiseiSimConfig config;
+	TaiseiSimEpisodeConfig episode;
+	StageInfo *stage;
+
+	Replay replay;
+	bool have_replay;
+
+	// episode lifecycle
+	bool episode_exists;     // reset() succeeded at least once
+	bool stage_running;      // stage event loop frame is on the stack
+	bool abort_requested;
+	bool gameover_hook_fired;
+	int gameover_freeze_left; // > 0: game frozen pending STATUS_LOST
+	int final_gameover;      // global.gameover observed when the stage loop stopped
+	uint32_t status;
+	int32_t gameover_frame;
+	uint64_t logical_frame;
+	uint64_t start_time;
+
+	// virtual keyboard
+	uint32_t buttons_requested;
+	uint32_t buttons_seen;   // as delivered to the game through edges
+
+	// derived per-step telemetry
+	cmplx prev_player_pos;
+	float boss_recent_damage;
+
+	// snapshot (frozen when the stage loop stops: entities are freed by stage_end_loop)
+	TaiseiSimState snap;
+	SimArrays arr;
+	bool snap_frozen;
+
+	char error[SIM_ERRBUF_SIZE];
+};
+
+static struct {
+	bool initialized;
+	bool vfs_ready;
+	ResourceGroup rg;
+	TaiseiSim *sim;
+	char *temp_storage;
+	char global_error[SIM_ERRBUF_SIZE];
+} simg;
+
+static int32_t sim_fail(TaiseiSim *sim, int32_t code, const char *fmt, ...) {
+	char *buf = sim ? sim->error : simg.global_error;
+	va_list ap;
+	va_start(ap, fmt);
+	vsnprintf(buf, SIM_ERRBUF_SIZE, fmt, ap);
+	va_end(ap);
+	return code;
+}
+
+TAISEI_SIM_API const char *taisei_sim_last_error(TaiseiSim *sim) {
+	if(sim && sim->error[0]) {
+		return sim->error;
+	}
+
+	return simg.global_error[0] ? simg.global_error : NULL;
+}
+
+/* ---------------------------------------------------------------------------------------- */
+/* Virtual keyboard hooks                                                                   */
+/* ---------------------------------------------------------------------------------------- */
+
+static const struct { uint32_t button; KeyIndex key; } button_map[] = {
+	{ TAISEI_SIM_BUTTON_UP,      KEY_UP },
+	{ TAISEI_SIM_BUTTON_DOWN,    KEY_DOWN },
+	{ TAISEI_SIM_BUTTON_LEFT,    KEY_LEFT },
+	{ TAISEI_SIM_BUTTON_RIGHT,   KEY_RIGHT },
+	{ TAISEI_SIM_BUTTON_FOCUS,   KEY_FOCUS },
+	{ TAISEI_SIM_BUTTON_SHOT,    KEY_SHOT },
+	{ TAISEI_SIM_BUTTON_BOMB,    KEY_BOMB },
+	{ TAISEI_SIM_BUTTON_SPECIAL, KEY_SPECIAL },
+};
+
+#define SIM_ALL_BUTTONS 0xFFu
+
+static bool hook_key_held(KeyIndex key) {
+	TaiseiSim *sim = simg.sim;
+
+	if(!sim) {
+		return false;
+	}
+
+	for(int i = 0; i < ARRAY_SIZE(button_map); ++i) {
+		if(button_map[i].key == key) {
+			return sim->buttons_seen & button_map[i].button;
+		}
+	}
+
+	return false;
+}
+
+static int hook_key_edges(int max, TaiseiSimKeyEdge edges[]) {
+	TaiseiSim *sim = simg.sim;
+
+	if(!sim) {
+		return 0;
+	}
+
+	uint32_t want = sim->buttons_requested & SIM_ALL_BUTTONS;
+	uint32_t have = sim->buttons_seen;
+	int n = 0;
+
+	// releases first, then presses; both in fixed key order (deterministic)
+	for(int pass = 0; pass < 2; ++pass) {
+		for(int i = 0; i < ARRAY_SIZE(button_map) && n < max; ++i) {
+			uint32_t b = button_map[i].button;
+			bool was = have & b, is = want & b;
+
+			if(pass == 0 && was && !is) {
+				edges[n++] = (TaiseiSimKeyEdge) { .key = button_map[i].key, .down = false };
+			} else if(pass == 1 && !was && is) {
+				edges[n++] = (TaiseiSimKeyEdge) { .key = button_map[i].key, .down = true };
+			}
+		}
+	}
+
+	sim->buttons_seen = want;
+	return n;
+}
+
+static void hook_on_stage_start(void) {
+	TaiseiSim *sim = simg.sim;
+
+	if(!sim) {
+		return;
+	}
+
+	const TaiseiSimEpisodeConfig *e = &sim->episode;
+	Player *plr = &global.plr;
+
+	#define OVERRIDE_I32(field, target, lo, hi) \
+		if(e->field != TAISEI_SIM_DEFAULT_I32) { target = clamp(e->field, lo, hi); }
+
+	OVERRIDE_I32(initial_lives, plr->lives, 0, PLR_MAX_LIVES);
+	OVERRIDE_I32(initial_bombs, plr->bombs, 0, PLR_MAX_BOMBS);
+	OVERRIDE_I32(initial_life_fragments, plr->life_fragments, 0, PLR_MAX_LIFE_FRAGMENTS - 1);
+	OVERRIDE_I32(initial_bomb_fragments, plr->bomb_fragments, 0, PLR_MAX_BOMB_FRAGMENTS - 1);
+	OVERRIDE_I32(initial_power, plr->power_stored, 0, PLR_MAX_POWER_STORED);
+	if(e->initial_point_item_value != TAISEI_SIM_DEFAULT_I32 && e->initial_point_item_value > 0) {
+		plr->point_item_value = e->initial_point_item_value;
+	}
+	#undef OVERRIDE_I32
+
+	if(e->initial_score && e->initial_score != TAISEI_SIM_DEFAULT_U64) {
+		plr->points = e->initial_score;
+	}
+
+	if(e->initial_graze) {
+		plr->graze = e->initial_graze;
+	}
+
+	// The visual RNG never influences gameplay, but seed it too so the process is reproducible.
+	rng_seed(&global.rand_visual, e->rng_seed ^ UINT64_C(0x9E3779B97F4A7C15));
+}
+
+static void hook_on_gameover(void) {
+	TaiseiSim *sim = simg.sim;
+
+	if(sim) {
+		sim->gameover_hook_fired = true;
+		sim->gameover_frame = global.frames;
+		sim->gameover_freeze_left = SIM_GAMEOVER_FREEZE_FRAMES;
+		// the remainder of this logic frame still runs, then the stage is frozen
+	} else {
+		global.gameover = GAMEOVER_DEFEAT;
+	}
+}
+
+static void sim_install_hooks(void) {
+	taisei_sim_hooks = (TaiseiSimHooks) {
+		.active = true,
+		.key_held = hook_key_held,
+		.key_edges = hook_key_edges,
+		.on_stage_start = hook_on_stage_start,
+		.on_gameover = hook_on_gameover,
+		.skip_dialog_waits = true,
+	};
+}
+
+/* ---------------------------------------------------------------------------------------- */
+/* Global init / shutdown (mirrors main.c, headless path)                                   */
+/* ---------------------------------------------------------------------------------------- */
+
+static void sim_vfs_ready(CallChainResult ccr) {
+	simg.vfs_ready = true;
+}
+
+static char *sim_make_temp_storage(void) {
+	const char *tmp = env_get_string_nonempty("TMPDIR", "/tmp");
+	size_t len = strlen(tmp) + 32;
+	char *path = malloc(len);
+	snprintf(path, len, "%s/taisei-sim-XXXXXX", tmp);
+
+	if(!mkdtemp(path)) {
+		free(path);
+		return NULL;
+	}
+
+	return path;
+}
+
+TAISEI_SIM_API int32_t taisei_sim_global_init(const TaiseiSimGlobalConfig *cfg) {
+	if(simg.initialized) {
+		return sim_fail(NULL, TAISEI_SIM_E_ALREADY_INITIALIZED, "already initialized");
+	}
+
+	if(!cfg) {
+		return sim_fail(NULL, TAISEI_SIM_E_INVALID_ARGUMENT, "config is NULL");
+	}
+
+	if(cfg->struct_size != sizeof(*cfg)) {
+		return sim_fail(NULL, TAISEI_SIM_E_BAD_STRUCT_SIZE, "global config struct_size %u != %zu",
+			cfg->struct_size, sizeof(*cfg));
+	}
+
+	if(cfg->api_version != TAISEI_SIM_API_VERSION) {
+		return sim_fail(NULL, TAISEI_SIM_E_API_VERSION, "api_version %u != %u",
+			cfg->api_version, TAISEI_SIM_API_VERSION);
+	}
+
+	// Must precede any SDL allocation (env_set allocates through SDL): every SDL allocation
+	// has to come from the same allocator that will later free it.
+	setlocale(LC_ALL, "C");
+	mem_install_sdl_callbacks();
+
+	if(cfg->resource_path) {
+		env_set("TAISEI_RES_PATH", cfg->resource_path, true);
+	}
+
+	if(cfg->storage_path) {
+		env_set("TAISEI_STORAGE_PATH", cfg->storage_path, true);
+	} else {
+		simg.temp_storage = sim_make_temp_storage();
+
+		if(!simg.temp_storage) {
+			return sim_fail(NULL, TAISEI_SIM_E_IO, "could not create temporary storage directory");
+		}
+
+		env_set("TAISEI_STORAGE_PATH", simg.temp_storage, true);
+	}
+
+	if(cfg->cache_path) {
+		env_set("TAISEI_CACHE_PATH", cfg->cache_path, true);
+	}
+
+	env_set("SDL_AUDIODRIVER", "dummy", true);
+	env_set("SDL_VIDEODRIVER", "dummy", true);
+	env_set("TAISEI_AUDIO_BACKEND", "null", true);
+	env_set("TAISEI_RENDERER", "null", true);
+
+	thread_init();
+	coroutines_init();
+
+	LogLevel lvls = log_parse_levels(LOG_ALERT, env_get("TAISEI_SIM_LOGLVLS", ""));
+	log_init(LOG_DEFAULT_LEVELS);
+	log_add_output(lvls, SDL_RWFromFP(stderr, false), log_formatter_console);
+
+	stageinfo_init();
+
+	vfs_setup(CALLCHAIN(sim_vfs_ready, NULL));
+
+	if(!simg.vfs_ready) {
+		return sim_fail(NULL, TAISEI_SIM_E_INTERNAL, "VFS setup did not complete synchronously");
+	}
+
+	config_load();
+
+	if(!SDL_Init(SDL_INIT_EVENTS)) {
+		return sim_fail(NULL, TAISEI_SIM_E_INTERNAL, "SDL_Init failed: %s", SDL_GetError());
+	}
+
+	taskmgr_global_init();
+	time_init();
+	init_global(&(CLIAction) { .type = CLI_VerifyReplay });
+	events_init();
+	video_init(&(VideoInitParams) { 0 });
+	filewatch_init();
+	res_init();
+	r_models_init();
+	r_sprite_batch_init();
+	r_post_init();
+	res_group_init(&simg.rg);
+	i18n_init();
+	dynstage_init_monitoring();
+	audio_init();
+	res_post_init();
+	gamepad_init();
+	progress_load();
+	progress_unlock_all();  // every stage/spell selectable, like --unlock-all
+	video_post_init();
+
+	sim_install_hooks();
+	simg.initialized = true;
+	simg.global_error[0] = 0;
+	log_info("taisei_sim: initialization complete");
+	return TAISEI_SIM_OK;
+}
+
+static int32_t sim_end_stage(TaiseiSim *sim);
+
+TAISEI_SIM_API int32_t taisei_sim_global_shutdown(void) {
+	if(!simg.initialized) {
+		return sim_fail(NULL, TAISEI_SIM_E_NOT_INITIALIZED, "not initialized");
+	}
+
+	if(simg.sim) {
+		taisei_sim_destroy(simg.sim);
+	}
+
+	taisei_sim_hooks = (TaiseiSimHooks) {};
+
+	// Subset of taisei_shutdown(); persistent data is intentionally not committed.
+	i18n_shutdown();
+	r_release_resources();
+	res_group_release(&simg.rg);
+	res_shutdown();
+	progress_unload();
+	stage_objpools_shutdown();
+	taskmgr_global_shutdown();
+	audio_shutdown();
+	r_models_shutdown();
+	r_sprite_batch_shutdown();
+	video_shutdown();
+	gamepad_shutdown();
+	stageinfo_shutdown();
+	config_shutdown();
+	filewatch_shutdown();
+	vfs_shutdown();
+	events_shutdown();
+	time_shutdown();
+	coroutines_shutdown();
+	log_queue_shutdown();
+	thread_shutdown();
+	log_shutdown();
+	SDL_Quit();
+
+	free(simg.temp_storage);
+	simg = (typeof(simg)) {};
+	return TAISEI_SIM_OK;
+}
+
+/* ---------------------------------------------------------------------------------------- */
+/* Create / destroy                                                                         */
+/* ---------------------------------------------------------------------------------------- */
+
+TAISEI_SIM_API int32_t taisei_sim_create(const TaiseiSimConfig *config, TaiseiSim **out_sim) {
+	if(!simg.initialized) {
+		return sim_fail(NULL, TAISEI_SIM_E_NOT_INITIALIZED, "taisei_sim_global_init() not called");
+	}
+
+	if(!config || !out_sim) {
+		return sim_fail(NULL, TAISEI_SIM_E_INVALID_ARGUMENT, "NULL argument");
+	}
+
+	if(config->struct_size != sizeof(*config)) {
+		return sim_fail(NULL, TAISEI_SIM_E_BAD_STRUCT_SIZE, "config struct_size %u != %zu",
+			config->struct_size, sizeof(*config));
+	}
+
+	if(simg.sim) {
+		return sim_fail(NULL, TAISEI_SIM_E_BUSY, "only one simulation per process is supported");
+	}
+
+	TaiseiSim *sim = calloc(1, sizeof(*sim));
+	sim->config = *config;
+	sim->status = TAISEI_SIM_STATUS_NONE;
+	simg.sim = sim;
+	*out_sim = sim;
+	return TAISEI_SIM_OK;
+}
+
+static void free_arrays(SimArrays *a) {
+	free(a->projectiles);
+	free(a->enemies);
+	free(a->items);
+	free(a->lasers);
+	free(a->laser_points);
+	*a = (SimArrays) {};
+}
+
+TAISEI_SIM_API int32_t taisei_sim_destroy(TaiseiSim *sim) {
+	if(!sim || sim != simg.sim) {
+		return sim_fail(NULL, TAISEI_SIM_E_INVALID_ARGUMENT, "invalid handle");
+	}
+
+	if(sim->stage_running) {
+		sim_end_stage(sim);
+	}
+
+	if(sim->have_replay) {
+		replay_state_deinit(&global.replay.output);
+		replay_reset(&sim->replay);
+	}
+
+	free_arrays(&sim->arr);
+	free(sim);
+	simg.sim = NULL;
+	return TAISEI_SIM_OK;
+}
