--- /dev/null
+++ b/src/sim_hooks.h
@@ -0,0 +1,53 @@
+/*
+ * This software is licensed under the terms of the MIT License.
+ * See COPYING for further information.
+ * ---
+ * taisei-sim reconstruction: minimal hooks that let an embedding (libtaisei_sim)
+ * drive the unmodified game logic headlessly.
+ *
+ * When `taisei_sim_hooks.active` is false (the default, and always the case for the
+ * regular game executable), every hook is a no-op and the game behaves exactly as upstream.
+ */
+
+#pragma once
+#include "taisei.h"
+
+#include "config.h"
+
+typedef struct TaiseiSimKeyEdge {
+	int32_t key;   // KeyIndex
+	bool down;
+} TaiseiSimKeyEdge;
+
+typedef struct TaiseiSimHooks {
+	bool active;
+
+	// Deterministic episode seeding (applied in _stage_enter instead of makeseed()/time()).
+	bool override_seed;
+	uint64_t seed;
+	bool override_start_time;
+	uint64_t start_time;
+
+	// Virtual keyboard. `key_held` replaces the SDL keyboard state in gamekeypressed();
+	// `key_edges` yields press/release edges which are routed through the regular
+	// gameplay input handler, exactly as real key events would be.
+	bool (*key_held)(KeyIndex key);
+	int (*key_edges)(int max, TaiseiSimKeyEdge edges[]);
+
+	// Called at the end of stage_start(), before the replay stage is created, so that
+	// initial-state overrides are recorded into the replay.
+	void (*on_stage_start)(void);
+
+	// Dialogue lines complete immediately (as if skipped on the frame they appear).
+	// Matches the original taisei-sim: stage scripts proceed without dialogue delays.
+	// Unlike the other hooks this one is honoured even when `active` is false, so that the
+	// regular executable can play back / verify replays recorded by libtaisei_sim
+	// (set TAISEI_SIM_SKIP_DIALOG_WAITS=1).
+	bool skip_dialog_waits;
+
+	// Called instead of opening the game-over menu. The hook decides the outcome;
+	// if NULL, the stage ends with GAMEOVER_DEFEAT.
+	void (*on_gameover)(void);
+} TaiseiSimHooks;
+
+extern TaiseiSimHooks taisei_sim_hooks;
