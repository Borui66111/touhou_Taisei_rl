+/* ---------------------------------------------------------------------------------------- */
+/* Snapshot                                                                                 */
+/* ---------------------------------------------------------------------------------------- */
+
+#define ARR_PUSH(a, name) ( \
+	((a)->num_##name >= (a)->cap_##name ? ( \
+		(a)->cap_##name = max(16u, (a)->cap_##name * 2), \
+		(a)->name = realloc((a)->name, sizeof(*(a)->name) * (a)->cap_##name)) : 0), \
+	memset(&(a)->name[(a)->num_##name], 0, sizeof(*(a)->name)), \
+	&(a)->name[(a)->num_##name++])
+
+static inline TaiseiSimVec2 v2(cmplx c) {
+	return (TaiseiSimVec2) { re(c), im(c) };
+}
+
+static inline int32_t remaining(int t) {
+	return t > global.frames ? t - global.frames : 0;
+}
+
+static void digest_mix(uint64_t *h, const void *data, size_t size) {
+	const uint8_t *p = data;
+
+	for(size_t i = 0; i < size; ++i) {
+		*h ^= p[i];
+		*h *= UINT64_C(0x100000001b3);
+	}
+}
+
+#define DIGEST(h, v) do { typeof(v) _v = (v); digest_mix((h), &_v, sizeof(_v)); } while(0)
+
+static void snapshot_player(TaiseiSim *sim, TaiseiSimPlayerState *ps) {
+	Player *plr = &global.plr;
+
+	ps->position = v2(plr->pos);
+	ps->previous_position = v2(sim->prev_player_pos);
+	ps->velocity = v2(plr->velocity);
+	ps->input_flags = plr->inputflags;
+	ps->focused = (plr->inputflags & INFLAG_FOCUS) != 0;
+	ps->shooting = player_should_shoot(plr);
+	ps->lives = plr->lives;
+	ps->bombs = plr->bombs;
+	ps->life_fragments = plr->life_fragments;
+	ps->bomb_fragments = plr->bomb_fragments;
+	ps->stored_power = plr->power_stored;
+	ps->effective_power = player_get_effective_power(plr);
+	ps->point_item_value = plr->point_item_value;
+	ps->score = plr->points;
+	ps->graze = plr->graze;
+	ps->voltage = plr->voltage;
+	ps->alive = player_is_alive(plr);
+	ps->invulnerable = !player_is_vulnerable(plr);
+	ps->recovering = player_is_recovering(plr);
+	ps->death_timer = plr->deathtime >= global.frames ? plr->deathtime - global.frames : 0;
+	ps->respawn_timer = remaining(plr->respawntime);
+	ps->recovery_timer = remaining(plr->recoverytime);
+	ps->bomb_active = player_is_bomb_active(plr);
+	ps->bomb_progress = player_get_bomb_progress(plr);
+	ps->bomb_trigger_frame = plr->bomb_triggertime;
+	ps->bomb_end_frame = plr->bomb_endtime;
+	ps->power_surge_active = player_is_powersurge_active(plr);
+	ps->power_surge_positive = plr->powersurge.positive;
+	ps->power_surge_negative = plr->powersurge.negative;
+
+	if(plr->mode) {
+		ps->player_character = plr->mode->character->id;
+		ps->shot_mode = plr->mode->shot_mode;
+	}
+}
+
+static void snapshot_boss(TaiseiSim *sim, TaiseiSimBossState *bs) {
+	Boss *boss = global.boss;
+	bs->recent_damage = sim->boss_recent_damage;
+	bs->phase_index = -1;
+
+	if(!boss) {
+		return;
+	}
+
+	bs->active = 1;
+	bs->position = v2(boss->pos);
+	bs->velocity = v2(boss->move.velocity);
+	bs->invulnerable = !boss_is_vulnerable(boss);
+
+	Attack *a = boss->current;
+
+	if(a && a >= boss->attacks && a < boss->attacks + boss->acount) {
+		int idx = a - boss->attacks;
+		bs->hp = a->hp;
+		bs->max_hp = a->maxhp;
+		bs->phase_index = idx;
+		bs->phase_type = (uint32_t)a->type + 1;  // 0 = no attack; matches original taisei-sim
+		bs->attack_id = idx;
+		bs->spell_id = (a->info && global.diff >= D_Easy && global.diff <= D_Lunatic)
+			? (uint16_t)(int16_t)a->info->idmap[global.diff - D_Easy] : UINT16_MAX;
+		bs->spell_active = ATTACK_IS_SPELL(a->type) && attack_is_active(a);
+		bs->phase_start_frame = a->starttime;
+		bs->phase_end_frame = a->endtime;
+		bs->phase_timeout_frames = a->timeout;
+		bs->remaining_timeout_frames = remaining(a->starttime + a->timeout);  // includes start delay
+		bs->spell_failed_frame = a->failtime;
+		bs->spell_failed = attack_was_failed(a);
+		bs->spell_captured = ATTACK_IS_SPELL(a->type) && attack_has_finished(a) && !attack_was_failed(a);
+	}
+}
+
+static void snapshot_laser_points(TaiseiSim *sim, Laser *l, TaiseiSimLaserState *ls) {
+	SimArrays *arr = &sim->arr;
+	ls->first_point = arr->num_laser_points;
+
+	int ofs = l->_internal.segments_ofs;
+	int nsegs = l->_internal.num_segments;
+
+	if(nsegs < 1 || ofs < 0 || ofs + nsegs > (int)lintern.segments.num_elements) {
+		ls->point_count = 0;
+		return;
+	}
+
+	if(sim->config.laser_sample_step > 0) {
+		// resample the collision geometry at a fixed arc-length step (approximation:
+		// half_width is interpolated from the segment endpoints)
+		real step = sim->config.laser_sample_step;
+
+		for(int i = 0; i < nsegs; ++i) {
+			LaserSegment *s = dynarray_get_ptr(&lintern.segments, ofs + i);
+			cmplx a = s->pos.a, b = s->pos.b;
+			real len = cabs(b - a);
+			int n = max(1, (int)ceil(len / step));
+
+			for(int k = (i == 0 ? 0 : 1); k <= n; ++k) {
+				real f = (real)k / n;
+				TaiseiSimLaserPoint *p = ARR_PUSH(arr, laser_points);
+				p->position = v2(clerp(a, b, f));
+				p->half_width = 0.5f * lerpf(s->width.a, s->width.b, f);
+				p->time = lerpf(s->time.a, s->time.b, f);
+			}
+		}
+	} else {
+		// export the quantized collision segments (the exact geometry used by laser_collision)
+		cmplx prev_end = INFINITY;
+
+		for(int i = 0; i < nsegs; ++i) {
+			LaserSegment s = dynarray_get(&lintern.segments, ofs + i);
+
+			if(prev_end != s.pos.a && prev_end == s.pos.b) {
+				// segment stored flipped (see quantize_laser)
+				s = (LaserSegment) {
+					.pos = { s.pos.b, s.pos.a },
+					.width = { s.width.b, s.width.a },
+					.time = { s.time.b, s.time.a },
+				};
+			}
+
+			if(prev_end != s.pos.a) {
+				TaiseiSimLaserPoint *p = ARR_PUSH(arr, laser_points);
+				p->position = v2(s.pos.a);
+				p->half_width = 0.5f * s.width.a;
+				p->time = s.time.a;
+				p->flags = TAISEI_SIM_LASER_POINT_SEGMENT_START |
+					(i > 0 ? TAISEI_SIM_LASER_POINT_DISCONTINUITY : 0);
+			}
+
+			TaiseiSimLaserPoint *p = ARR_PUSH(arr, laser_points);
+			p->position = v2(s.pos.b);
+			p->half_width = 0.5f * s.width.b;
+			p->time = s.time.b;
+			p->flags = TAISEI_SIM_LASER_POINT_SEGMENT_END;
+			prev_end = s.pos.b;
+		}
+	}
+
+	ls->point_count = arr->num_laser_points - ls->first_point;
+}
+
+static void build_snapshot(TaiseiSim *sim) {
+	TaiseiSimState *st = &sim->snap;
+	SimArrays *arr = &sim->arr;
+	uint64_t h = UINT64_C(0xcbf29ce484222325);
+
+	*st = (TaiseiSimState) {
+		.struct_size = sizeof(TaiseiSimState),
+		.api_version = TAISEI_SIM_API_VERSION,
+		.stage_id = sim->episode.stage_id,
+		.stage_type = sim->stage ? sim->stage->type : 0,
+		.difficulty = global.diff,
+		.player_character = sim->episode.player_character,
+		.shot_mode = sim->episode.shot_mode,
+		.practice_mode = sim->episode.practice_mode,
+		.logical_frame = sim->logical_frame,
+		.initial_rng_seed = sim->episode.rng_seed,
+		.start_time = sim->start_time,
+		.episode_status = sim->status,
+		.gameover_frame = sim->gameover_frame,
+	};
+
+	arr->num_projectiles = arr->num_enemies = arr->num_items = 0;
+	arr->num_lasers = arr->num_laser_points = 0;
+
+	if(!sim->stage_running) {
+		return;
+	}
+
+	Player *plr = &global.plr;
+	st->stage_clear = stage_is_cleared() || sim->status == TAISEI_SIM_STATUS_WON;
+	st->game_over = sim->status == TAISEI_SIM_STATUS_LOST;
+	st->score = plr->points;
+	st->graze = plr->graze;
+	st->voltage = plr->voltage;
+	st->deaths = plr->stats.total.lives_used;
+	st->bombs_used = plr->stats.total.bombs_used;
+	st->continues_used = plr->stats.total.continues_used;
+	snapshot_player(sim, &st->player);
+	snapshot_boss(sim, &st->boss);
+
+	DIGEST(&h, global.frames);
+	digest_mix(&h, global.rand_game.state, sizeof(global.rand_game.state));
+	DIGEST(&h, plr->pos);
+	DIGEST(&h, plr->lives);
+	DIGEST(&h, plr->bombs);
+	DIGEST(&h, plr->power_stored);
+	DIGEST(&h, plr->points);
+	DIGEST(&h, plr->graze);
+	DIGEST(&h, plr->voltage);
+	DIGEST(&h, plr->inputflags);
+
+	for(Projectile *p = global.projs.first; p; p = p->next) {
+		TaiseiSimProjectileState *ps = ARR_PUSH(arr, projectiles);
+		ps->spawn_id = p->ent.spawn_id;
+		ps->category = p->type;
+		ps->position = v2(p->pos);
+		ps->previous_position = v2(p->prevpos);
+		ps->velocity = v2(p->move.velocity);
+		ps->collision_size = v2(p->collision_size);
+		ps->damage = p->damage;
+		ps->angle = p->angle;
+		ps->age_frames = global.frames - p->birthtime;
+		ps->flags = p->flags;
+		ps->damage_type = p->damage_type;
+		ps->clear_flags = p->clear_flags;
+		DIGEST(&h, p->type);
+		DIGEST(&h, p->pos);
+	}
+
+	for(Enemy *e = global.enemies.first; e; e = e->next) {
+		TaiseiSimEnemyState *es = ARR_PUSH(arr, enemies);
+		es->spawn_id = e->ent.spawn_id;
+		es->position = v2(e->pos);
+		es->velocity = v2(e->move.velocity);
+		es->hp = e->hp;
+		es->max_hp = e->spawn_hp;
+		es->hit_radius = e->hit_radius;
+		es->hurt_radius = e->hurt_radius;
+		es->age_frames = global.frames - e->birthtime;
+		es->flags = e->flags;
+		es->damageable = !(e->flags & (EFLAG_NO_HIT | EFLAG_INVULNERABLE | EFLAG_KILLED));
+		es->harmful = !(e->flags & (EFLAG_NO_HURT | EFLAG_KILLED));
+		DIGEST(&h, e->pos);
+		DIGEST(&h, e->hp);
+	}
+
+	for(Item *it = global.items.first; it; it = it->next) {
+		TaiseiSimItemState *is = ARR_PUSH(arr, items);
+		is->spawn_id = it->ent.spawn_id;
+		is->position = v2(it->pos);
+		is->velocity = v2(it->v);
+		is->item_type = it->type;
+		is->age_frames = global.frames - it->birthtime;
+		is->collect_frame = it->collecttime;
+		is->attracted = it->auto_collect != 0;
+		is->pickup_value = it->pickup_value;
+		DIGEST(&h, it->pos);
+	}
+
+	for(Laser *l = global.lasers.first; l; l = l->next) {
+		TaiseiSimLaserState *ls = ARR_PUSH(arr, lasers);
+		ls->spawn_id = l->ent.spawn_id;
+		ls->origin = v2(l->pos);
+		ls->age_frames = global.frames - l->birthtime;
+		ls->width = l->width;
+		ls->speed = l->speed;
+		ls->timespan = l->timespan;
+		ls->death_time = l->deathtime;
+		ls->time_shift = l->timeshift;
+		ls->collision_active = laser_is_active(l);
+		ls->unclearable = l->unclearable;
+		ls->clear_flags = l->clear_flags;
+		snapshot_laser_points(sim, l, ls);
+		DIGEST(&h, l->pos);
+		DIGEST(&h, l->width);
+	}
+
+	if(global.boss && global.boss->current) {
+		DIGEST(&h, global.boss->pos);
+		DIGEST(&h, global.boss->current->hp);
+	}
+
+	st->projectile_count = arr->num_projectiles;
+	st->enemy_count = arr->num_enemies;
+	st->item_count = arr->num_items;
+	st->laser_count = arr->num_lasers;
+	st->laser_point_count = arr->num_laser_points;
+	st->gameplay_digest = h;
+}
+
+/* ---------------------------------------------------------------------------------------- */
+/* Episode control                                                                          */
+/* ---------------------------------------------------------------------------------------- */
+
+static void sim_stage_finished(CallChainResult ccr) {
+	TaiseiSim *sim = ccr.ctx;
+	sim->stage_running = false;
+}
+
+static uint32_t status_from_gameover(TaiseiSim *sim, int gameover) {
+	if(sim->abort_requested) {
+		return TAISEI_SIM_STATUS_ABORTED;
+	}
+
+	switch(gameover) {
+		case GAMEOVER_WIN:        return TAISEI_SIM_STATUS_WON;
+		case GAMEOVER_SCORESCREEN:return TAISEI_SIM_STATUS_WON;
+		case GAMEOVER_DEFEAT:     return TAISEI_SIM_STATUS_LOST;
+		case GAMEOVER_RESTART:    return TAISEI_SIM_STATUS_ABORTED;
+		case GAMEOVER_ABORT:      return TAISEI_SIM_STATUS_ABORTED;
+		default:                  return TAISEI_SIM_STATUS_ERROR;
+	}
+}
+
+// Runs exactly one logic frame of the stage loop. Returns false once the loop has stopped.
+static bool sim_run_frame(TaiseiSim *sim);
+
+static bool sim_run_frozen_gameover_frame(TaiseiSim *sim) {
+	// The game is paused: logical time does not advance at all
+	// (archived: logical_frame == 1 + elapsed steps - 15 for lost episodes).
+	if(--sim->gameover_freeze_left > 0) {
+		return true;
+	}
+
+	// equivalent to choosing "quit" on the game-over menu with no continues left
+	sim->status = TAISEI_SIM_STATUS_LOST;
+	sim->snap.episode_status = sim->status;
+	sim->snap.logical_frame = sim->logical_frame;
+	sim->snap.game_over = 1;
+	return false;
+}
+
+static bool sim_run_frame(TaiseiSim *sim) {
+	if(sim->gameover_hook_fired && sim->status == TAISEI_SIM_STATUS_RUNNING && !sim->abort_requested) {
+		return sim_run_frozen_gameover_frame(sim);
+	}
+
+	LoopFrame *frame = evloop.stack_ptr;
+
+	if(!frame || frame->logic == NULL || frame->context == NULL) {
+		sim->status = TAISEI_SIM_STATUS_ERROR;
+		sim_fail(sim, TAISEI_SIM_E_INTERNAL, "event loop stack is empty");
+		return false;
+	}
+
+	Boss *boss_before = global.boss;
+	Attack *atk_before = boss_before ? boss_before->current : NULL;
+	float hp_before = atk_before ? atk_before->hp : 0;
+	sim->prev_player_pos = global.plr.pos;
+
+	LogicFrameAction a = run_logic_frame(frame);
+
+	if(evloop.stack_ptr != frame) {
+		// something pushed another loop frame (a menu); this must never happen in sim mode
+		sim->status = TAISEI_SIM_STATUS_ERROR;
+		sim_fail(sim, TAISEI_SIM_E_INTERNAL, "unexpected event loop frame pushed during stage logic");
+		return false;
+	}
+
+	if(global.boss && global.boss == boss_before && global.boss->current == atk_before && atk_before) {
+		float d = hp_before - atk_before->hp;
+
+		if(d > 0) {
+			sim->boss_recent_damage += d;
+		}
+	}
+
+	++sim->logical_frame;
+
+	if(a == LFRAME_STOP) {
+		sim->final_gameover = global.gameover;
+		sim->status = status_from_gameover(sim, global.gameover);
+
+		if(sim->status == TAISEI_SIM_STATUS_LOST && sim->gameover_frame < 0) {
+			sim->gameover_frame = global.frames;
+		}
+
+		build_snapshot(sim);
+		sim->snap.stage_clear = sim->status == TAISEI_SIM_STATUS_WON;
+		sim->snap.game_over = sim->status == TAISEI_SIM_STATUS_LOST;
+		sim->snap_frozen = true;
+
+		eventloop_leave();  // -> stage_end_loop -> sim_stage_finished
+		assert(!sim->stage_running);
+		sim->stage_running = false;
+		return false;
+	}
+
+	if(global.gameover == GAMEOVER_SCORESCREEN) {
+		// stage cleared: the score screen is purely cosmetic
+		sim->status = TAISEI_SIM_STATUS_WON;
+	}
+
+	if(sim->gameover_hook_fired) {
+		// freeze the observable state at the game-over frame
+		build_snapshot(sim);
+		sim->snap_frozen = true;
+	}
+
+	return true;
+}
+
+static int32_t sim_end_stage(TaiseiSim *sim) {
+	if(!sim->stage_running) {
+		return TAISEI_SIM_OK;
+	}
+
+	bool lost = sim->status == TAISEI_SIM_STATUS_LOST;
+	sim->abort_requested = !lost;
+	sim->buttons_requested = 0;
+	sim->gameover_hook_fired = false;
+
+	for(int i = 0; i < 16 && sim->stage_running; ++i) {
+		if(global.gameover <= 0) {
+			global.gameover = lost ? GAMEOVER_DEFEAT : GAMEOVER_ABORT;
+		}
+
+		if(!sim_run_frame(sim)) {
+			break;
+		}
+	}
+
+	if(sim->stage_running) {
+		return sim_fail(sim, TAISEI_SIM_E_INTERNAL, "failed to tear down the running stage");
+	}
+
+	return TAISEI_SIM_OK;
+}
+
+TAISEI_SIM_API int32_t taisei_sim_reset(TaiseiSim *sim, const TaiseiSimEpisodeConfig *episode) {
+	if(!sim || sim != simg.sim) {
+		return sim_fail(NULL, TAISEI_SIM_E_INVALID_ARGUMENT, "invalid handle");
+	}
+
+	sim->error[0] = 0;
+
+	if(!episode) {
+		return sim_fail(sim, TAISEI_SIM_E_INVALID_ARGUMENT, "episode config is NULL");
+	}
+
+	if(episode->struct_size != sizeof(*episode)) {
+		return sim_fail(sim, TAISEI_SIM_E_BAD_STRUCT_SIZE, "episode config struct_size %u != %zu",
+			episode->struct_size, sizeof(*episode));
+	}
+
+	StageInfo *stg = stageinfo_get_by_id(episode->stage_id);
+
+	if(!stg) {
+		return sim_fail(sim, TAISEI_SIM_E_UNKNOWN_STAGE, "unknown stage id 0x%x", episode->stage_id);
+	}
+
+	PlayerMode *mode = plrmode_find(episode->player_character, episode->shot_mode);
+
+	if(!mode) {
+		return sim_fail(sim, TAISEI_SIM_E_INVALID_ARGUMENT, "unknown player mode %u/%u",
+			episode->player_character, episode->shot_mode);
+	}
+
+	if(episode->difficulty > D_Lunatic) {
+		return sim_fail(sim, TAISEI_SIM_E_INVALID_ARGUMENT, "invalid difficulty %u", episode->difficulty);
+	}
+
+	int32_t r = sim_end_stage(sim);
+
+	if(r != TAISEI_SIM_OK) {
+		return r;
+	}
+
+	// fresh episode state
+	sim->episode = *episode;
+	sim->stage = stg;
+	sim->abort_requested = false;
+	sim->gameover_hook_fired = false;
+	sim->gameover_freeze_left = 0;
+	sim->final_gameover = 0;
+	sim->gameover_frame = -1;
+	sim->logical_frame = 0;
+	sim->buttons_requested = 0;
+	sim->buttons_seen = 0;
+	sim->boss_recent_damage = 0;
+	sim->snap_frozen = false;
+	sim->start_time = (episode->start_time == TAISEI_SIM_DEFAULT_U64) ? 0 : episode->start_time;
+
+	taisei_sim_hooks.override_seed = true;
+	taisei_sim_hooks.seed = episode->rng_seed;
+	taisei_sim_hooks.override_start_time = true;
+	taisei_sim_hooks.start_time = sim->start_time;
+
+	// mirrors main_singlestg / main_singlestg_begin_game
+	global.diff = episode->difficulty ? episode->difficulty : (stg->difficulty ? stg->difficulty : D_Easy);
+	global.is_practice_mode = episode->practice_mode != 0;
+
+	if(sim->have_replay) {
+		replay_state_deinit(&global.replay.output);
+		replay_reset(&sim->replay);
+	}
+
+	sim->replay = (Replay) {};
+	stralloc(&sim->replay.playername, "taisei-sim");
+	replay_state_init_record(&global.replay.output, &sim->replay);
+	replay_state_deinit(&global.replay.input);
+	sim->have_replay = true;
+
+	global.gameover = 0;
+	player_init(&global.plr);
+	stats_init(&global.plr.stats);
+	global.plr.mode = mode;
+
+	sim->stage_running = true;
+	sim->status = TAISEI_SIM_STATUS_RUNNING;
+	stage_enter(stg, &simg.rg, CALLCHAIN(sim_stage_finished, sim));
+
+	if(evloop.stack_ptr == NULL) {
+		sim->stage_running = false;
+		sim->status = TAISEI_SIM_STATUS_ERROR;
+		return sim_fail(sim, TAISEI_SIM_E_INTERNAL, "stage_enter did not start the stage loop");
+	}
+
+	// Run the stage's first logic frame (stage begin proc + player post-init; the stage
+	// coroutine yields before it ever reads input). The original taisei-sim did the same:
+	// with this warm-up frame, step k of a fresh episode reproduces step k of the archived
+	// native smoke traces exactly.
+	if(!sim_run_frame(sim) || sim->status != TAISEI_SIM_STATUS_RUNNING) {
+		return sim_fail(sim, TAISEI_SIM_E_INTERNAL, "stage ended during its first frame");
+	}
+
+	// logical_frame counts executed stage logic frames, including this warm-up frame:
+	// it is 1 right after reset, as in the archived traces.
+	assert(sim->logical_frame == 1);
+	sim->boss_recent_damage = 0;
+	sim->prev_player_pos = global.plr.pos;
+	return TAISEI_SIM_OK;
+}
+
+TAISEI_SIM_API int32_t taisei_sim_step(TaiseiSim *sim, const TaiseiSimAction *action, uint32_t frames) {
+	if(!sim || sim != simg.sim) {
+		return sim_fail(NULL, TAISEI_SIM_E_INVALID_ARGUMENT, "invalid handle");
+	}
+
+	if(!action) {
+		return sim_fail(sim, TAISEI_SIM_E_INVALID_ARGUMENT, "action is NULL");
+	}
+
+	if(action->struct_size != sizeof(*action)) {
+		return sim_fail(sim, TAISEI_SIM_E_BAD_STRUCT_SIZE, "action struct_size %u != %zu",
+			action->struct_size, sizeof(*action));
+	}
+
+	if(sim->status == TAISEI_SIM_STATUS_NONE) {
+		return sim_fail(sim, TAISEI_SIM_E_NO_EPISODE, "taisei_sim_reset() not called");
+	}
+
+	if(sim->status != TAISEI_SIM_STATUS_RUNNING || !sim->stage_running) {
+		return sim_fail(sim, TAISEI_SIM_E_EPISODE_OVER, "episode is over (status %u)", sim->status);
+	}
+
+	sim->buttons_requested = action->buttons & SIM_ALL_BUTTONS;
+	sim->boss_recent_damage = 0;
+
+	for(uint32_t i = 0; i < frames; ++i) {
+		if(!sim_run_frame(sim)) {
+			break;
+		}
+
+		if(sim->status != TAISEI_SIM_STATUS_RUNNING) {
+			break;
+		}
+	}
+
+	if(sim->status == TAISEI_SIM_STATUS_ERROR) {
+		return TAISEI_SIM_E_INTERNAL;
+	}
+
+	return TAISEI_SIM_OK;
+}
+
+TAISEI_SIM_API int32_t taisei_sim_get_state(TaiseiSim *sim, TaiseiSimState *state, TaiseiSimStateBuffers *buffers) {
+	if(!sim || sim != simg.sim) {
+		return sim_fail(NULL, TAISEI_SIM_E_INVALID_ARGUMENT, "invalid handle");
+	}
+
+	if(!state) {
+		return sim_fail(sim, TAISEI_SIM_E_INVALID_ARGUMENT, "state is NULL");
+	}
+
+	if(state->struct_size != sizeof(*state)) {
+		return sim_fail(sim, TAISEI_SIM_E_BAD_STRUCT_SIZE, "state struct_size %u != %zu",
+			state->struct_size, sizeof(*state));
+	}
+
+	if(!sim->snap_frozen) {
+		build_snapshot(sim);
+	}
+
+	sim->snap.boss.recent_damage = sim->boss_recent_damage;
+	*state = sim->snap;
+
+	if(!buffers) {
+		return TAISEI_SIM_OK;
+	}
+
+	if(buffers->struct_size != sizeof(*buffers)) {
+		return sim_fail(sim, TAISEI_SIM_E_BAD_STRUCT_SIZE, "buffers struct_size %u != %zu",
+			buffers->struct_size, sizeof(*buffers));
+	}
+
+	SimArrays *a = &sim->arr;
+	bool too_small = false;
+
+	#define COPY_OUT(name, cap) do { \
+		if(a->num_##name > buffers->cap) { \
+			too_small = true; \
+		} else if(a->num_##name) { \
+			if(!buffers->name) { return sim_fail(sim, TAISEI_SIM_E_INVALID_ARGUMENT, #name " buffer is NULL"); } \
+			memcpy(buffers->name, a->name, sizeof(*a->name) * a->num_##name); \
+		} \
+	} while(0)
+
+	COPY_OUT(projectiles, projectile_capacity);
+	COPY_OUT(enemies, enemy_capacity);
+	COPY_OUT(items, item_capacity);
+	COPY_OUT(lasers, laser_capacity);
+	COPY_OUT(laser_points, laser_point_capacity);
+	#undef COPY_OUT
+
+	if(too_small) {
+		return sim_fail(sim, TAISEI_SIM_E_BUFFER_TOO_SMALL, "state buffers too small");
+	}
+
+	return TAISEI_SIM_OK;
+}
+
+TAISEI_SIM_API int32_t taisei_sim_save_replay(TaiseiSim *sim, const char *path) {
+	if(!sim || sim != simg.sim) {
+		return sim_fail(NULL, TAISEI_SIM_E_INVALID_ARGUMENT, "invalid handle");
+	}
+
+	if(!path) {
+		return sim_fail(sim, TAISEI_SIM_E_INVALID_ARGUMENT, "path is NULL");
+	}
+
+	if(!sim->have_replay || sim->replay.stages.num_elements < 1) {
+		return sim_fail(sim, TAISEI_SIM_E_NO_EPISODE, "no recorded episode");
+	}
+
+	SDL_IOStream *out = SDL_IOFromFile(path, "wb");
+
+	if(!out) {
+		return sim_fail(sim, TAISEI_SIM_E_IO, "cannot open %s: %s", path, SDL_GetError());
+	}
+
+	// A replay of a still-running episode gets a provisional terminator, exactly like
+	// stage_end_loop would append, and it is removed again afterwards.
+	ReplayStage *rstg = NULL;
+	bool provisional = false;
+	uint64_t saved_points = 0;
+
+	if(sim->stage_running && global.replay.output.stage) {
+		rstg = global.replay.output.stage;
+		saved_points = rstg->plr_points_final;
+		replay_stage_event(rstg, global.frames, EV_OVER, 0);
+		rstg->plr_points_final = global.plr.points;
+		provisional = true;
+	}
+
+	bool ok = replay_write(&sim->replay, out, REPLAY_STRUCT_VERSION_WRITE);
+	SDL_CloseIO(out);
+
+	if(provisional) {
+		rstg->events.num_elements--;
+		rstg->plr_points_final = saved_points;
+	}
+
+	if(!ok) {
+		return sim_fail(sim, TAISEI_SIM_E_IO, "replay_write failed");
+	}
+
+	return TAISEI_SIM_OK;
+}
